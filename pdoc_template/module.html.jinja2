{#
Extends pdoc's default page template. The look is in `custom.css`; this file adds what
CSS cannot: a scroll-spy that marks, in the sidebar, the section currently in view.
#}
{% extends "default/module.html.jinja2" %}

{#
As pdoc's, except that a class's members fold into a <details>, closed until the
scroll-spy (below) opens it for the class in view, or the reader clicks its chevron.
The class link sits in the <summary>: clicking the *link* navigates without toggling
(the anchor is the activation target), clicking the rest of the row toggles.
#}
{% macro nav_members(members) %}
    <ul class="memberlist">
        {% for m in members if is_public(m) | trim %}
            <li>
                {% if m.kind == "class" and m.own_members %}
                    <details>
                        <summary><a class="class" href="#{{ m.qualname }}">{{ m.qualname }}</a></summary>
                        {{ nav_members(m.own_members) | indent(12) }}
                    </details>
                {% elif m.kind == "class" %}
                    <a class="class" href="#{{ m.qualname }}">{{ m.qualname }}</a>
                {% elif m.kind == "module" %}
                    <a class="module" href="#{{ m.name }}">{{ m.name }}</a>
                {% elif m.name == "__init__" %}
                    <a class="function" href="#{{ m.qualname }}">{{ m.qualname.split(".")[-2] }}</a>
                {% else %}
                    <a class="{{ m.kind }}" href="#{{ m.qualname }}">{{ m.name }}</a>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
{% endmacro %}

{#
pdoc's, except on a top-level page, where pdoc's "Module Index" button (there being two
roots, `TPFA_ResSim` and `examples`) leads to the other root instead; the index itself
(`index.html.jinja2`) merely redirects to `TPFA_ResSim`.
#}
{% block module_list_link %}
    {% if "." in module.modulename %}
        {{ super() }}
    {% else %}
        {% for name in all_modules if "." not in name and name != module.modulename %}
            <a class="pdoc-button module-list-button" href="{{ name }}.html">{{ name }} &rarr;</a>
        {% endfor %}
    {% endif %}
{% endblock %}

{#
As pdoc's (less the edit button, unused here), but with the figures an example makes
inserted between its prose and its source: `build.py` runs the examples, saves their
figures, and hands the template the files and captions as `example_figures`.
#}
{% block module_info %}
    <section class="module-info">
        {{ module_name() }}
        {{ docstring(module) }}
        {% for file, caption in (example_figures | default({})).get(module.modulename, []) %}
            <figure class="example-figure">
                <img src="{{ file }}" alt="{{ caption }}">
                <figcaption>{{ caption }}</figcaption>
            </figure>
        {% endfor %}
        {{ view_source_state(module) }}
        {{ view_source_button(module) }}
        {{ view_source_code(module) }}
    </section>
{% endblock %}

{#
An example is a script: its module-level names (`model`, `dt`, ...) are not an API, so
neither the sidebar's "API Documentation" nor the member sections are rendered for it.
Its page is the docstring, the figures, and the source.
#}
{% set is_example = module.modulename.split(".")[0] == "examples" %}
{% block nav_members %}
    {% if not is_example %}{{ super() }}{% endif %}
{% endblock %}
{% block module_contents %}
    {% if not is_example %}{{ super() }}{% endif %}
{% endblock %}

{% block nav_footer %}
    <footer>
        <a href="https://github.com/patnr/TPFA-ResSim">patnr/TPFA-ResSim</a> on GitHub
        &middot; MIT licence
    </footer>
{% endblock %}

{% block body %}
    {{ super() }}
    <script>
    (function () {
        // Scroll-spy: mark the sidebar link whose target was scrolled past most recently
        // (i.e. the section the reader is in), and keep that link visible in the sidebar.
        const nav = document.querySelector("nav.pdoc");
        const targets = [];  // [element, link], in document order
        for (const a of nav.querySelectorAll('a[href^="#"]')) {
            const el = document.getElementById(decodeURIComponent(a.hash.slice(1)));
            if (el) targets.push([el, a]);
        }
        if (!targets.length) return;
        targets.sort((p, q) => p[0].compareDocumentPosition(q[0]) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1);

        let current = null;
        function update() {
            // A section counts as "in view" once its heading is in the top third of the
            // viewport, so the mark moves on as the reader reaches the next one.
            const line = window.innerHeight / 3;
            let link = null;
            for (const [el, a] of targets) {
                if (el.getBoundingClientRect().top <= line) link = a; else break;
            }
            if (link === current) return;
            if (current) current.classList.remove("active");
            current = link;
            if (!link) return;
            link.classList.add("active");
            // Unfold the class(es) the entry sits in.
            for (let d = link.closest("details"); d; d = d.parentElement.closest("details")) {
                d.open = true;
            }
            // Keep the marked entry visible, scrolling the sidebar (not the page).
            if (nav.scrollHeight > nav.clientHeight) {
                const n = nav.getBoundingClientRect(), l = link.getBoundingClientRect();
                if (l.top < n.top || l.bottom > n.bottom) {
                    nav.scrollTop += l.top - n.top - n.height / 2 + l.height / 2;
                }
            }
        }
        let pending = false;
        window.addEventListener("scroll", () => {
            if (pending) return;
            pending = true;
            requestAnimationFrame(() => { pending = false; update(); });
        }, { passive: true });
        window.addEventListener("resize", update);
        // The page also reflows without scrolling, e.g. as MathJax typesets.
        if (window.ResizeObserver) new ResizeObserver(update).observe(document.body);
        update();
    })();
    </script>
{% endblock %}
